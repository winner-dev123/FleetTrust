{
  "name": "@fleettrust/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FleetTrust Next.js web app: public site, user/provider/fleet apps and admin console.",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint .",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@firebase/app": "0.16.6",
    "@firebase/auth": "1.13.10",
    "@fleettrust/copy": "workspace:*",
    "@fleettrust/env": "workspace:*",
    "@fleettrust/sdk": "workspace:*",
    "@fleettrust/types": "workspace:*",
    "@fleettrust/ui": "workspace:*",
    "next": "16.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fleettrust/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "19.3.0",
    "axe-core": "^4.14.1",
    "eslint": "catalog:",
    "jsdom": "26.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
