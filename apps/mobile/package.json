    "react": "catalog:",
    "react-native": "0.88.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
