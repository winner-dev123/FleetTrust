{
  // Strict FleetTrust flags first, then Expo's bundler/JSX settings on top.
  "extends": ["@fleettrust/config/tsconfig/base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "app.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
