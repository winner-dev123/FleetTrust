{
  "name": "fleettrust",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm guard:modules && turbo run lint typecheck test build",
    "clean": "turbo run clean",
    "infra:env": "node tools/local-infra/src/cli.ts env",
    "infra:up": "node tools/local-infra/src/cli.ts up",
    "infra:up:all": "node tools/local-infra/src/cli.ts up --all",
    "infra:status": "node tools/local-infra/src/cli.ts status",
    "infra:down": "node tools/local-infra/src/cli.ts down",
    "infra:destroy": "node tools/local-infra/src/cli.ts destroy",
    "emulators": "node tools/local-infra/src/cli.ts emulators",
    "guard:modules": "node tools/repo-guards/src/cli.ts",
    "db:generate": "pnpm --filter @fleettrust/db generate",
    "db:migrate": "turbo run build --filter=@fleettrust/db --output-logs=errors-only && pnpm --filter @fleettrust/db migrate",
    "db:seed": "turbo run build --filter=@fleettrust/db --output-logs=errors-only && pnpm --filter @fleettrust/db seed",
    "db:reset": "turbo run build --filter=@fleettrust/db --output-logs=errors-only && pnpm --filter @fleettrust/db reset",
    "db:staff": "turbo run build --filter=@fleettrust/db --output-logs=errors-only && pnpm --filter @fleettrust/db staff",
    "test:db": "turbo run build --filter=@fleettrust/db --output-logs=errors-only && pnpm --filter @fleettrust/db test:pg"
  },
  "devDependencies": {
    "@fleettrust/config": "workspace:*",
    "firebase-tools": "15.37.0",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
