{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleettrust.invalid/rfcs/events/EscrowReleased.schema.json",
  "title": "EscrowReleased",
  "description": "Held funds were released to the provider's connected account. PROPOSED in RFC-0002: specification only (ADR-0011), not emitted by any code.",
  "x-fleettrust": {
    "status": "proposed",
    "rfc": "RFC-0002",
    "module": "payments",
    "aggregateType": "service_request",
    "transport": "transactional outbox (ADR-0007)",
    "delivery": "at least once; consumers are idempotent on the outbox event ID"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "paymentIntentId",
    "providerOrganizationId",
    "amount",
    "trigger",
    "occurredAt"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "paymentIntentId": {
      "type": "string",
      "format": "uuid"
    },
    "providerOrganizationId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "object",
      "required": ["amount", "currency"],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(.[0-9]{1,2})?$",
          "description": "Decimal string in major units, never a float"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217"
        }
      }
    },
    "trigger": {
      "type": "string",
      "enum": ["customer_confirmed", "confirmation_window_elapsed", "dispute_resolved"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
