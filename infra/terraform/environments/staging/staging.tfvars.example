# Copy to staging.tfvars (not committed: it names people and accounts).
project_id      = "fleettrust-staging"
alert_email     = "ops@example.com"
billing_account = "" # XXXXXX-XXXXXX-XXXXXX to enable the budget alert
budget_currency = "USD" # must be the billing account's currency (Billing > Account management)
monthly_budget  = 200   # in budget_currency
web_origins     = ["https://staging.example.com"]
api_host        = "" # e.g. api.staging.example.com, after the first deploy
web_host        = "" # e.g. staging.example.com, after the first deploy
api_domain      = "" # e.g. api.staging.example.com: creates the load balancer, certificate and Cloud Armor
