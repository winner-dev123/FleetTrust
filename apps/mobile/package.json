{
  "name": "@fleettrust/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "FleetTrust iOS/Android app (Expo, React Native).",
  "main": "index.ts",
  "scripts": {
    "build": "expo export --output-dir dist",
