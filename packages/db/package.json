{
  "name": "@fleettrust/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL/PostGIS schema, migrations, seed data and database helpers (Drizzle ORM).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pg": "node --env-file-if-exists=../../infra/local/.env ./node_modules/vitest/vitest.mjs run",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../infra/local/.env dist/cli/migrate.js",
    "seed": "node --env-file-if-exists=../../infra/local/.env dist/cli/seed.js",
    "reset": "node --env-file-if-exists=../../infra/local/.env dist/cli/reset.js",
    "staff": "node --env-file-if-exists=../../infra/local/.env dist/cli/staff.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuidv7": "1.2.1"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-postgis": "0.2.16"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-postgis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-postgis": "0.2.16",
    "@fleettrust/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
