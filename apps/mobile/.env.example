# Copy to .env for local overrides. EXPO_PUBLIC_* values are embedded in the app
# bundle and readable by anyone with the app: never put secrets in them.

# local | test | staging | production
EXPO_PUBLIC_APP_ENV=local
# Required outside local/test. Android emulator: use http://10.0.2.2:8080 to reach the host.
EXPO_PUBLIC_API_URL=http://localhost:8080
