{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleettrust.invalid/rfcs/events/EngagementPointsReversed.schema.json",
  "title": "EngagementPointsReversed",
  "description": "A reversal entry was written (sanction or correction). PROPOSED in RFC-0001: specification only (ADR-0011), not emitted by any code.",
  "x-fleettrust": {
    "status": "proposed",
    "rfc": "RFC-0001",
    "module": "engagement",
    "aggregateType": "user",
    "transport": "transactional outbox (ADR-0007)",
    "delivery": "at least once; consumers are idempotent on the outbox event ID"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "entryId", "reversesEntryId", "points", "reason", "occurredAt"],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "entryId": {
      "type": "string",
      "format": "uuid"
    },
    "reversesEntryId": {
      "type": "string",
      "format": "uuid"
    },
    "points": {
      "type": "integer",
      "maximum": -1
    },
    "reason": {
      "type": "string",
      "enum": ["sanction", "content_removed", "correction"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
