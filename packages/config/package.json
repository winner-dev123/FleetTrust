{
  "name": "@fleettrust/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint and Prettier presets (development tooling only).",
  "exports": {
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/next": "./eslint/next.js",
    "./prettier": "./prettier.js"
  },
  "files": [
    "eslint",
    "tsconfig",
    "prettier.js"
  ],
  "scripts": {
    "lint": "eslint ."
  },
  "dependencies": {
    "@eslint/js": "catalog:",
