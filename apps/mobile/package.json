{
  "name": "@fleettrust/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "FleetTrust iOS/Android app (Expo dev builds, Expo Router, React Native Firebase).",
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --output-dir dist",
    "dev": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fleettrust/copy": "workspace:*",
    "@fleettrust/env": "workspace:*",
    "@fleettrust/sdk": "workspace:*",
    "@fleettrust/types": "workspace:*",
    "@fleettrust/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "27.1.1",
    "@react-native-firebase/app-check": "27.1.1",
    "@react-native-firebase/auth": "27.1.1",
    "@react-native-firebase/installations": "27.1.1",
    "@react-native-firebase/messaging": "27.1.1",
    "expo": "58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-status-bar": "58.0.5",
    "react": "catalog:",
    "react-native": "0.88.1",
    "react-native-permissions": "5.6.3",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fleettrust/config": "workspace:*",
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "test-renderer": "1.3.1",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@react-native-firebase/(.*)$": "<rootDir>/test/stubs/react-native-firebase.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "testTimeout": 30000
  }
}
