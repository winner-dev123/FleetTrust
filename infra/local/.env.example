# Reference only. Run `pnpm infra:env` to generate infra/local/.env with random passwords.
# The generated file is git-ignored and is never needed outside your machine.

POSTGRES_USER=fleettrust
POSTGRES_PASSWORD=<generated>
POSTGRES_DB=fleettrust
POSTGRES_TEST_DB=fleettrust_test
POSTGRES_PORT=5432

REDIS_PASSWORD=<generated>
