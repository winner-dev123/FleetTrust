{
  "name": "@fleettrust/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FleetTrust Next.js web app: public site, user/provider/fleet apps and admin console.",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
