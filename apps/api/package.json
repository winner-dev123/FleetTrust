{
  "name": "@fleettrust/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FleetTrust NestJS modular-monolith API (runs as role=api or role=worker).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fleettrust/config": "workspace:*",
    "@fleettrust/db": "workspace:*",
    "@fleettrust/types": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-postgis": "0.2.15",
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "eslint": "catalog:",
    "supertest": "7.3.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
