# Copy to .env.local for local overrides. NEXT_PUBLIC_* values are embedded in the
# browser bundle at build time: never put secrets in them.

# local | test | staging | production
NEXT_PUBLIC_APP_ENV=local
# Required outside local/test. Defaults to http://localhost:8080 locally.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Firebase (sign-in) ---
# Local: leave unset to use the demo project; run `pnpm emulators` and set the emulator host.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fleettrust
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Deployed: values from Firebase console > Project settings > Your apps (public identifiers, not secrets).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_APP_ID=
