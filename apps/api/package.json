{
  "name": "@fleettrust/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FleetTrust NestJS modular-monolith API (runs as role=api or role=worker).",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:tracing": "node scripts/smoke-tracing.mjs",
    "test:integration": "node --env-file-if-exists=../../infra/local/.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fleettrust/db": "workspace:*",
    "@fleettrust/env": "workspace:*",
    "@fleettrust/types": "workspace:*",
    "@google-cloud/storage": "9.0.0",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "firebase-admin": "14.5.1",
    "google-auth-library": "11.3.4",
    "pino": "10.4.0",
    "redis": "6.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-postgis": "0.2.16",
    "@fleettrust/config": "workspace:*",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.2",
    "@swc/core": "1.16.22",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "eslint": "catalog:",
    "supertest": "7.3.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
