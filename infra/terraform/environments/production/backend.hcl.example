# Copy to backend.hcl (not committed). The bucket is created once, by hand, before the first init:
#   gcloud storage buckets create gs://fleettrust-production-tfstate --location=europe-west1 #     --uniform-bucket-level-access --public-access-prevention
#   gcloud storage buckets update gs://fleettrust-production-tfstate --versioning
bucket = "fleettrust-production-tfstate"
prefix = "fleettrust"
