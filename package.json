{
  "name": "fleettrust",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "clean": "turbo run clean",
    "infra:env": "node tools/local-infra/src/cli.ts env",
    "infra:up": "node tools/local-infra/src/cli.ts up",
    "infra:up:all": "node tools/local-infra/src/cli.ts up --all",
    "infra:status": "node tools/local-infra/src/cli.ts status",
    "infra:down": "node tools/local-infra/src/cli.ts down",
    "infra:destroy": "node tools/local-infra/src/cli.ts destroy",
    "emulators": "node tools/local-infra/src/cli.ts emulators"
  },
  "devDependencies": {
    "@fleettrust/config": "workspace:*",
    "firebase-tools": "15.36.0",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
