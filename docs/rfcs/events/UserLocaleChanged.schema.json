{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleettrust.invalid/rfcs/events/UserLocaleChanged.schema.json",
  "title": "UserLocaleChanged",
  "description": "A person changed their language preference. PROPOSED in RFC-0006: specification only (ADR-0011), not emitted by any code.",
  "x-fleettrust": {
    "status": "proposed",
    "rfc": "RFC-0006",
    "module": "i18n",
    "aggregateType": "user",
    "transport": "transactional outbox (ADR-0007)",
    "delivery": "at least once; consumers are idempotent on the outbox event ID"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "locale", "previousLocale", "occurredAt"],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
      "description": "BCP 47 language tag"
    },
    "previousLocale": {
      "type": ["string", "null"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
