# Copy to .env for local overrides. Every variable is optional locally; defaults are safe for development.
# Never put real credentials in this file. Deployed environments read secrets from Secret Manager.

# development | test | production
NODE_ENV=development
# local | test | staging | production
APP_ENV=local
# api | worker (same image, two Cloud Run services)
APP_ROLE=api
# Set by CI in deployed environments
APP_VERSION=0.0.0-dev
PORT=8080
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# PostgreSQL. Optional locally: without it the API runs and /health/ready reports not_configured.
# `pnpm infra:up` writes a working value to infra/local/.env (DATABASE_URL); copy it here.
# DATABASE_URL=postgresql://fleettrust:<from infra/local/.env>@127.0.0.1:5432/fleettrust
DB_POOL_MAX=5

# --- Authentication (Firebase, docs/operations/authentication.md) ---
# Firebase project whose ID tokens are accepted. demo-* IDs work only with the emulators.
FIREBASE_PROJECT_ID=demo-fleettrust
# Local only: use the Auth emulator (`pnpm emulators`). NEVER set in staging/production:
# the emulator accepts unsigned tokens, and the API refuses to start if this is set there.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# App Check: off | monitor | enforce (production requires enforce)
APP_CHECK_MODE=off
# Shared rate limits. Without it, an in-memory limiter is used (local only).
# REDIS_URL=redis://:<from infra/local/.env>@127.0.0.1:6379/0
# Proxies appending to X-Forwarded-For (Cloud Run: 1). 0 = use the socket address.
TRUST_PROXY_HOPS=0
